# Copy to `config.toml` and point ANDROID_NDK at your own NDK install.
#
# Only Android cross-compilation needs this. llama-cpp-sys-2 looks up the NDK
# twice: its bindgen path falls back to ~/Android/Sdk/ndk/<latest>, but its
# cmake path (build.rs, the one Gradle's build actually reaches) requires
# ANDROID_NDK, NDK_ROOT or ANDROID_NDK_ROOT explicitly and panics without one.
#
# Host builds need nothing here. LIBCLANG_PATH is not required either — bindgen
# finds the system libclang on its own, for Android targets as well as the host.
#
# `config.toml` is gitignored: cargo does not expand `~` or `$HOME`, so the
# value has to be a literal path, and a tracked one pins the build to whoever
# committed it. Exporting ANDROID_NDK in your shell works too and takes
# precedence over this file — the file exists so that builds launched from
# Android Studio, which may not inherit your shell environment, work as well.
#
# Match the NDK version ari-android pins in `app/build.gradle.kts` (ndkVersion).

[env]
ANDROID_NDK = "/home/you/Android/Sdk/ndk/28.0.13004108"
